# String de conexão MySQL usada pelo Prisma
DATABASE_URL="mysql://usuario:senha@host:3306/cerca_trova"

# Segredo forte e privado usado para assinar JWT
JWT_SECRETO="troque-por-um-segredo-longo-e-aleatorio"

# Porta fornecida pelo ambiente de hospedagem
PORT=3333

# Domínios do frontend separados por vírgula
CORS_ORIGINS="http://localhost:5173"
