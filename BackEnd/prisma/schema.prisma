generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuarios {
  id                        String        @id @default(uuid())
  nome                      String
  email                     String        @unique
  senha                     String
  telefone                  String        @default("")
  foto_perfil               String?
  foto_capa                 String?
  tipo                      String        @default("USUARIO")
  verificado                Boolean       @default(false)
  data_criacao              DateTime      @default(now())
  data_atualizacao          DateTime      @updatedAt
  publicacoes               Publicacoes[]
  favoritos                 Favoritos[]
  petsTinder                PetsTinder[]
  conversasComoRemetente    Conversas[]   @relation("ConversaRemetente")
  conversasComoDestinatario Conversas[]   @relation("ConversaDestinatario")
  mensagens                 Mensagens[]

  ongsId String?

  @@map("usuarios")
}

model Ongs {
  id        String  @id @default(uuid())
  nome      String
  email     String
  senha     String
  descricao String
  foto      String
  cidade    String
  estado    String
  telefone  String
  instagram String?
  site      String?

  @@map("ongs")
}

model Publicacoes {
  id   String @id @default(uuid())
  // Categoria editorial da publicação, como ADOCAO, PERDIDO ou ENCONTRADO.
  tipo String @default("ADOCAO")

  status           Boolean     @default(true)
  nome_pet         String
  especie          String
  raca             String
  idade_pet        String
  sexo             String
  porte            String
  descricao        String
  foto             String
  cidade           String
  estado           String
  id_usuario       String
  usuario          Usuarios    @relation(fields: [id_usuario], references: [id])
  favoritos        Favoritos[]
  conversas        Conversas[]
  data_criacao     DateTime    @default(now())
  data_atualizacao DateTime    @updatedAt

  @@map("publicacoes")
}

model Favoritos {
  id             String      @id @default(uuid())
  id_usuarios    String
  id_publicacoes String
  usuario        Usuarios    @relation(fields: [id_usuarios], references: [id])
  publicacao     Publicacoes @relation(fields: [id_publicacoes], references: [id])

  @@map("favoritos")
}

// Pet cadastrado pelo usuário para participar do catálogo TinderPet.
model PetsTinder {
  id            String   @id @default(uuid())
  nome          String
  especie       String
  raca          String   @default("")
  idade         String
  sexo          String
  porte         String
  cidade        String
  descricao     String   @db.Text
  foto          String   @db.LongText
  personalidade String   @default("")
  ativo         Boolean  @default(true)
  id_usuario    String
  usuario       Usuarios @relation(fields: [id_usuario], references: [id], onDelete: Cascade)

  data_criacao     DateTime @default(now())
  data_atualizacao DateTime @updatedAt

  @@index([id_usuario, ativo])
  @@map("pets_tinder")
}

// Conversa privada entre o usuário autenticado e o dono de uma publicação.
model Conversas {
  id               String       @id @default(uuid())
  id_publicacao    String?
  publicacao       Publicacoes? @relation(fields: [id_publicacao], references: [id])
  id_remetente     String
  id_destinatario  String
  remetente        Usuarios     @relation("ConversaRemetente", fields: [id_remetente], references: [id])
  destinatario     Usuarios     @relation("ConversaDestinatario", fields: [id_destinatario], references: [id])
  mensagens        Mensagens[]
  data_criacao     DateTime     @default(now())
  data_atualizacao DateTime     @updatedAt

  @@index([id_remetente, id_destinatario])
  @@index([id_publicacao])
  @@map("conversas")
}

// Mensagens reais enviadas dentro de uma conversa persistida.
model Mensagens {
  id           String    @id @default(uuid())
  id_conversa  String
  id_usuario   String
  texto        String    @db.Text
  conversa     Conversas @relation(fields: [id_conversa], references: [id], onDelete: Cascade)
  usuario      Usuarios  @relation(fields: [id_usuario], references: [id])
  data_criacao DateTime  @default(now())

  @@index([id_conversa, data_criacao])
  @@map("mensagens")
}
