generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuarios {
  id         String  @id @default(uuid())
  email      String
  senha      String
  telefone   String
  tipo       String
  verificado Boolean

  data_criacao     DateTime @default(now())
  data_atualizacao DateTime @updatedAt

  pets        Pets[]
  publicacoes Publicacoes[]
  favoritos   Favoritos[]
  comentarios Comentarios[]

  @@map("usuarios")
}

model Pets {
  id        String @id @default(uuid())
  nome      String
  especie   String
  reca      String
  idade     String
  sexo      String
  porte     String
  descricao String

  id_usuario  String
  usuario     Usuarios      @relation(fields: [id_usuario], references: [id])
  publicacoes Publicacoes[]

  data_criacao     DateTime @default(now())
  data_atualizacao DateTime @updatedAt

  @@map("pets")
}

model Publicacoes {
  id        String  @id @default(uuid())
  pet       String
  tipo      String
  status    Boolean
  data      String
  nome_pet  String
  especie   String
  raca      String
  idade_pet String
  porte     String
  descricao String

  id_usuario  String
  usuarios    Usuarios      @relation(fields: [id_usuario], references: [id])
  id_pets     String
  pets        Pets          @relation(fields: [id_pets], references: [id])
  favoritos   Favoritos[]
  comentarios Comentarios[]

  data_criacao     DateTime @default(now())
  data_atualizacao DateTime @updatedAt

  @@map("publicacoes")
}

model Favoritos {
  usuarios      Usuarios    @relation(fields: [id_usuarios], references: [id])
  id_usuarios    String
  publicacoes   Publicacoes @relation(fields: [id_publicacoes], references: [id])
  id_publicacoes String
}

model Comentarios {
  id       String @id @default(uuid())
  mensagem String

  usuario        Usuarios    @relation(fields: [id_usuarios], references: [id])
  id_usuarios    String
  publicacoes    Publicacoes @relation(fields: [id_publicacoes], references: [id])
  id_publicacoes String
}
