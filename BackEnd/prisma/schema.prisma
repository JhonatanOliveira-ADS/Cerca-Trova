generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuarios {
  id               String      @id @default(uuid())
  nome             String
  email            String      @unique
  senha            String
  telefone         String
  foto_perfil      String
  tipo             tipoUsuario @default(USUARIO)
  verificado       Boolean     @default(false)
  data_criacao     DateTime    @default(now())
  data_atualizacao DateTime    @updatedAt

  publicacoes Publicacoes[]
  favoritos   Favoritos[]
  ongsId      String?

  @@map("usuarios")
}

model Ongs {
  id        String     @id @default(uuid())
  nome      String
  email     String
  senha     String
  descricao String
  foto      String
  cidade    String
  estado    String
  telefone  String
  instagram String
  site      String

  @@map("ongs")
}

model Publicacoes {
  id         String         @id @default(uuid())
  tipo       tipoPublicacao
  status     Boolean        @default(true)
  nome_pet   String
  especie    String
  raca       String
  idade_pet  String
  sexo       String
  porte      String
  descricao  String
  foto       String
  cidade     String
  estado     String
  id_usuario String

  usuario   Usuarios    @relation(fields: [id_usuario], references: [id])
  favoritos Favoritos[]

  data_criacao     DateTime @default(now())
  data_atualizacao DateTime @updatedAt

  @@map("publicacoes")
}

model Favoritos {
  id         String         @id @default(uuid())
  id_usuarios    String
  id_publicacoes String

  usuario    Usuarios    @relation(fields: [id_usuarios], references: [id])
  publicacao Publicacoes @relation(fields: [id_publicacoes], references: [id])

  
  @@map("favoritos")
}

enum tipoUsuario {
  USUARIO
  ONG
}

enum tipoPublicacao {
  ADOCAO
  ENCONTRADO
  PERDIDO
}
