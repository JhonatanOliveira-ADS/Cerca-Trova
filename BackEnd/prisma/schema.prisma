generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuarios {
  id         String      @id @default(uuid())
  nome       String
  email      String      @unique
  senha      String
  telefone   String
  tipo       tipoUsuario @default(USUARIO)
  verificado Boolean

  data_criacao     DateTime @default(now())
  data_atualizacao DateTime @updatedAt

  publicacoes Publicacoes[]
  favoritos   Favoritos[]

  @@map("usuarios")
}

model Publicacoes {
  id   String         @id @default(uuid())
  tipo tipoPublicacao

  nome_pet  String
  especie   String
  raca      String
  idade_pet String
  sexo      String
  porte     String
  descricao String
  foto      String

  cidade String
  estado String

  status Boolean @default(true)

  id_usuario String
  usuarios   Usuarios    @relation(fields: [id_usuario], references: [id])
  favoritos  Favoritos[]

  data_criacao     DateTime @default(now())
  data_atualizacao DateTime @updatedAt

  @@map("publicacoes")
}

model Favoritos {
  usuarios       Usuarios    @relation(fields: [id_usuarios], references: [id])
  id_usuarios    String
  publicacoes    Publicacoes @relation(fields: [id_publicacoes], references: [id])
  id_publicacoes String
  //significa que a combinação dos dois campos é única.

  @@id([id_usuarios, id_publicacoes])
}

enum tipoUsuario {
  USUARIO
  ONG
}

enum tipoPublicacao {
  ADOCAO
  ENCONTRADO
  PERDIDO
}
